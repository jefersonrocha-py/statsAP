NEXT_PUBLIC_APP_NAME="Etherium Antennas"

NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"
HOST="0.0.0.0"
PORT="38410"
HOST_PORT="3200"
APP_URL="https://statsap.example.com"
NEXT_PUBLIC_APP_URL="https://statsap.example.com"
TRUST_PROXY_HEADERS="false"
COOKIE_SECURE="true"
ALLOW_SELF_REGISTER="false"

APP_IMAGE="monitoring_grandstream:latest"
PROXY_NETWORK="web"
WEB_PROXY_ALIAS="monitoring-grandstream-web"

MYSQL_IMAGE="mysql:8.4"
MYSQL_HOST="mysql-statsap"
MYSQL_PORT="38420"
MYSQL_DATABASE="monitoring_grandstream"
MYSQL_USER="monitoring_app"
MYSQL_PASSWORD="change-me-app-password"
MYSQL_ROOT_PASSWORD="change-me-root-password"
MYSQL_CHARSET="utf8mb4"
MYSQL_COLLATION="utf8mb4_unicode_ci"
DATABASE_URL="mysql://monitoring_app:change-me-app-password@mysql-statsap:38420/monitoring_grandstream"
MYSQL_POOL_SIZE="10"

MINIO_IMAGE="pgsty/minio:RELEASE.2026-08-04T00-00-00Z"
MINIO_ROOT_USER="statsap"
MINIO_ROOT_PASSWORD="change-me-minio-password"
MINIO_ENDPOINT="http://minio-statsap:38430"
MINIO_PORT="38430"
MINIO_BROWSER="off"
MINIO_BUCKET="statsap-avatars"

JWT_SECRET="change-me-jwt-secret-with-32-or-more-chars"
JWT_EXPIRES_DAYS="7"
INTERNAL_API_KEY="change-me-internal-api-key-24-chars"
PASSWORD_RESET_BASE_URL=""
PASSWORD_RESET_TOKEN_MINUTES="60"
INVITE_TOKEN_HOURS="72"
INCIDENT_ALERTS_ENABLED="true"
INCIDENT_ALERT_MIN_MINUTES="10"

EMAIL_DEFAULT_FROM="noreply@example.com"
EMAIL_TRANSPORT_DEFAULT_HOST="smtp.example.com"
EMAIL_TRANSPORT_DEFAULT_PORT="587"
EMAIL_TRANSPORT_DEFAULT_USERNAME=""
EMAIL_TRANSPORT_DEFAULT_PASSWORD=""
EMAIL_TRANSPORT_DEFAULT_TLS="true"

GDMS_BASE="https://www.gwn.cloud"
GDMS_OAUTH_URL="https://www.gwn.cloud/oauth/token"
GDMS_CLIENT_ID=""
GDMS_CLIENT_SECRET=""
GDMS_PAGE_SIZE="500"
GDMS_SHOW="all"

SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="change-me-superadmin-password"
SUPERADMIN_NAME="Root"
SEED_SUPERADMIN_ON_STARTUP="false"
SUPERADMIN_PROMOTE_IF_EXISTS="false"
SUPERADMIN_SYNC_PASSWORD_IF_EXISTS="false"

APP_BASE_URL="http://web-statsap:38410"
SYNC_PATH="/api/integrations/gdms/sync?mode=status"
SYNC_INTERVAL_MS="300000"
